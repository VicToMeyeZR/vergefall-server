# Copy to .env only on the server and replace every change_this value.
# Never commit the completed .env file.
# POSTGRES_PASSWORD is placed into a connection string; use only letters and numbers.
DOMAIN=server1.trystarbot.space
CADDY_EMAIL=admin@trystarbot.space
POSTGRES_PASSWORD=change_this_database_password
CONSOLE_USERNAME=vergefall_admin
CONSOLE_PASSWORD=change_this_console_password
CONSOLE_SIGNING_KEY=change_this_console_signing_key
SOCKET_SERVER_KEY=defaultkey
SESSION_ENCRYPTION_KEY=change_this_session_key
SESSION_REFRESH_ENCRYPTION_KEY=change_this_refresh_key
RUNTIME_HTTP_KEY=change_this_runtime_http_key
SESSION_TOKEN_EXPIRY_SEC=7200
SESSION_REFRESH_TOKEN_EXPIRY_SEC=604800
NAKAMA_LOG_LEVEL=INFO
